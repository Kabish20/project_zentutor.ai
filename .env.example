# Set these in the server environment. This file is documentation, not auto-loaded.
# Prefer AI Teacher > Connect OpenAI for a key scoped to your signed-in session.
# Without a key, live teacher messaging is unavailable; lesson notes still work.
# Environment settings override the ignored data/provider.local.json connection.
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
# Enable only when serving behind HTTPS.
MENTOR_SECURE_COOKIE=0
# Tests set this to 1 to prevent loading personal project credentials.
MENTOR_DISABLE_LOCAL_CONFIG=0
